{
  "name": "@chord-ts/clef",
  "version": "0.1.0",
  "description": "Embeddable OpenRPC reference & console — Swagger UI for JSON-RPC. One self-contained CDN file, Svelte 5 inside.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chord-ts/clef"
  },
  "keywords": [
    "openrpc",
    "json-rpc",
    "api-reference",
    "documentation",
    "swagger",
    "playground",
    "svelte",
    "cdn"
  ],
  "module": "./dist/clef.esm.js",
  "types": "./dist/types/public.d.ts",
  "unpkg": "./dist/clef.iife.js",
  "jsdelivr": "./dist/clef.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/clef.esm.js",
      "default": "./dist/clef.iife.js"
    },
    "./svelte": {
      "types": "./dist/types/svelte.d.ts",
      "import": "./dist/clef.svelte.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.svelte.config.ts && tsc -p tsconfig.build.json && node scripts/prepare-demo.mjs",
    "preview": "vite preview",
    "demo:server": "node demo/server.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "release": "pnpm check && pnpm test && bumpp --commit \"🔖 Release v%s\" --execute \"pnpm build\""
  },
  "devDependencies": {
    "@hono/vercel": "^1.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/ws": "^8.18.1",
    "bumpp": "^12.3.0",
    "hono": "^4.13.19",
    "jsdom": "^31.0.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}